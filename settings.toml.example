# Copy this file to settings.toml and fill in the values. settings.toml is gitignored.
# CircuitPython reads it on the board too, so `npm run deploy` copies it over.

# Wi-Fi: the board connects with these on its own at boot
CIRCUITPY_WIFI_SSID="your-network"
CIRCUITPY_WIFI_PASSWORD="your-wifi-password"

# The board's name on the network: lowercase letters, digits and hyphens only (no
# underscores). code.py also advertises it over mDNS, so the board is reachable at
# <hostname>.local, and the deploy scripts use it.
CIRCUITPY_WIFI_HOSTNAME="esp-radon"

# Web workflow. Use a password that is different from every other one here.
# Leave the User field blank when you type the password into the browser.
CIRCUITPY_WEB_API_PASSWORD="choose-a-password"
CIRCUITPY_WEB_API_PORT=80

# How often to take a reading, in milliseconds (120000 = 2 minutes)
sampling_interval=120000

# Limit for the pressure differential (see readme)
delta_threshold=70

# Send a "may be on battery power" notification when the battery gauge reads below
# this percent. Set to 0 to turn the notification off.
battery_notify_below=99

# Pin for the button. Short press: wake the screen / next page. Held while the board
# boots: keep USB mass storage enabled. D0 is the BOOT button.
button_pin="D0"

# Seconds without a button press before the screen turns off (it stays on while
# anything is failing). 0 keeps it on all the time.
display_timeout=60

# InfluxDB 1.x
db_host="influx-host.local"
db_port=8086
db_database="database"
db_table="measurement"
db_username="user"
db_password="password"

# Pushover
pushover_user="user-key"
pushover_token="app-token"
